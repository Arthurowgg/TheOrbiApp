<Window x:Class="Orbi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbi — Ajustes"
        Width="880" Height="620"
        MinWidth="760" MinHeight="520"
        Background="{StaticResource Paper}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- cabeçalho -->
    <Border Grid.Row="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}"
            BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="34" Height="34" Background="{StaticResource Ink}"
                CornerRadius="3" Margin="0,0,12,0">
          <TextBlock Text="&#x25CF;" Foreground="{StaticResource SignalBrush}" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="ORBI" Style="{StaticResource H2}" FontSize="17"/>
          <TextBlock x:Name="AccountLine" Text="Sem conta vinculada" Style="{StaticResource Label}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenBarButton" Content="Abrir a barra" Style="{StaticResource SecondaryButton}"
                  Click="OpenBar_Click" Margin="0,0,8,0"/>
          <Button Content="Sair" Style="{StaticResource GhostButton}" Click="Exit_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- corpo -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- nav -->
      <Border Grid.Column="0" Background="#FFF7F2E8" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavButton}"
                 SelectionChanged="Nav_SelectionChanged" Padding="8">
          <ListBoxItem Content="Geral" Tag="geral"/>
          <ListBoxItem Content="Ferramentas" Tag="ferramentas"/>
          <ListBoxItem Content="IA (Gemini)" Tag="ia"/>
          <ListBoxItem Content="Conta" Tag="conta"/>
          <ListBoxItem Content="Lembretes" Tag="lembretes"/>
          <ListBoxItem Content="Notas" Tag="notas"/>
          <ListBoxItem Content="Atalhos de texto" Tag="atalhos"/>
          <ListBoxItem Content="Memória" Tag="memoria"/>
          <ListBoxItem Content="Segurança" Tag="seguranca"/>
          <ListBoxItem Content="Sobre" Tag="sobre"/>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
        <Grid x:Name="Pages">

          <!-- GERAL -->
          <StackPanel x:Name="PageGeral">
            <TextBlock Text="Geral" Style="{StaticResource H1}"/>
            <TextBlock Text="Como o Orbi se comporta no seu Windows." Style="{StaticResource Muted}" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Seu nome" Style="{StaticResource Label}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}" Margin="0,6,0,0"/>
                <TextBlock Text="Usado nas saudações da barra." Style="{StaticResource Muted}" Margin="0,4,0,0"/>

                <Border Style="{StaticResource Divider}"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Atalho global" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HotkeyState" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
                    <ComboBox x:Name="HotkeyBox" Width="240" HorizontalAlignment="Left"
                              SelectionChanged="HotkeyBox_SelectionChanged"/>
                  </StackPanel>

                  <TextBlock Text="Abrir com o Windows" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <TextBlock Text="Fica na bandeja, pronto para Alt+Shift+O." Style="{StaticResource Muted}"/>
                  </StackPanel>
                  <ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                VerticalAlignment="Center"/>
                </Grid>

                <Border Style="{StaticResource Divider}"/>

                <TextBlock Text="Atalho global" Style="{StaticResource Label}"/>
                <TextBlock Text="Alt + Space abre a barra em qualquer programa." Style="{StaticResource Body}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Button Content="Salvar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Margin="0,16,0,0" Click="SaveGeneral_Click"/>
          </StackPanel>

          <!-- IA -->
          <!-- FERRAMENTAS -->
          <StackPanel x:Name="PageFerramentas" Visibility="Collapsed">
            <TextBlock Text="Ferramentas" Style="{StaticResource H1}"/>
            <TextBlock x:Name="ToolsCount" Style="{StaticResource Muted}" Margin="0,4,0,16"/>

            <TextBox x:Name="ToolsSearch" Style="{StaticResource Field}"
                     TextChanged="ToolsSearch_TextChanged"/>

            <ListBox x:Name="ToolsList" BorderThickness="0" Background="Transparent"
                     Margin="0,14,0,0" MaxHeight="460"
                     MouseDoubleClick="ToolsList_MouseDoubleClick"
                     KeyDown="ToolsList_KeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Group}"
                               Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Dê dois cliques (ou Enter) para executar. Na barra, digite / e o nome."
                       Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            <TextBlock x:Name="ToolsStatus" Style="{StaticResource MonoText}" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel x:Name="PageIa" Visibility="Collapsed">
            <TextBlock Text="Modo Cloud (Gemini)" Style="{StaticResource H1}"/>
            <TextBlock Text="Sem chave o Orbi já funciona: as ferramentas rodam no PC. Com uma chave gratuita do Google AI Studio, ele também conversa e entende pedidos livres."
                       Style="{StaticResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Modo Cloud ligado" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GeminiState" Style="{StaticResource Muted}"/>
                  </StackPanel>
                  <ToggleButton x:Name="GeminiToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                VerticalAlignment="Center"/>
                </Grid>

                <Border Style="{StaticResource Divider}"/>

                <TextBlock Text="Chave da API" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource PasswordField}" Margin="0,6,0,0"/>
                <TextBlock Text="Crie a sua em aistudio.google.com/apikey (leva um minuto, é gratuita). Ela fica cifrada neste PC com DPAPI: só este usuário do Windows consegue ler."
                           Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Button x:Name="OpenKeyPage" Content="Abrir a página da chave" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenKeyPage_Click"/>
                <TextBlock Text="Quem entra na conta do Orbi pode usar o modo Cloud sem colar chave nenhuma: o app usa a chave do projeto Orbi. A sua chave é só um atalho para não depender disso."
                           Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Salvar chave" Style="{StaticResource PrimaryButton}" Click="SaveKey_Click"/>
                  <Button Content="Testar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="TestKey_Click"/>
                  <Button Content="Remover" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="RemoveKey_Click"/>
                </StackPanel>

                <TextBlock x:Name="KeyStatus" Style="{StaticResource Muted}" Margin="0,10,0,0"/>

                <Border Style="{StaticResource Divider}"/>

                <TextBlock Text="Modelo" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ModelBox" Margin="0,6,0,0">
                  <ComboBoxItem Content="gemini-2.5-flash"/>
                  <ComboBoxItem Content="gemini-2.5-flash-lite"/>
                  <ComboBoxItem Content="gemini-2.0-flash"/>
                </ComboBox>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- CONTA -->
          <StackPanel x:Name="PageConta" Visibility="Collapsed">
            <TextBlock Text="Conta" Style="{StaticResource H1}"/>
            <TextBlock Text="A mesma conta do site, no Firebase. O app sincroniza pelo Firestore."
                       Style="{StaticResource Muted}" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Status" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="AccountBox" Style="{StaticResource Body}" FontWeight="SemiBold"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SyncStatus" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" VerticalAlignment="Top" Background="#22140F0C"
                          CornerRadius="3" Padding="8,4">
                    <TextBlock x:Name="UidBox" Style="{StaticResource Label}"/>
                  </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="LoginButton" Content="Entrar na conta" Style="{StaticResource PrimaryButton}"
                          Click="AccountLogin_Click"/>
                  <Button Content="Sincronizar agora" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="SyncNow_Click"/>
                  <Button Content="Enviar deste PC" Style="{StaticResource GhostButton}"
                          Margin="4,0,0,0" Click="PushNow_Click"/>
                  <Button Content="Sair" Style="{StaticResource GhostButton}" Click="AccountSignOut_Click"/>
                </StackPanel>

                <TextBlock x:Name="AccountHint" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <Border Style="{StaticResource Divider}"/>

                <TextBlock Text="O que sincroniza pelo Firestore" Style="{StaticResource Label}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="Memória do Orbi · atalhos de texto · rotinas · preferências (abrir com o Windows, volume, bloqueio) · nome"/>
                <Border Style="{StaticResource Divider}"/>
                <TextBlock Text="O que fica só neste PC" Style="{StaticResource Label}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="Notas · área de transferência · lembretes · chave do Gemini · histórico de comandos"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- LEMBRETES -->
          <StackPanel x:Name="PageLembretes" Visibility="Collapsed">
            <TextBlock Text="Lembretes" Style="{StaticResource H1}"/>
            <TextBlock Text="Avisos que continuam valendo mesmo depois de reiniciar o PC." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Card}">
              <ListBox x:Name="RemindersList" BorderThickness="0" Background="Transparent" MaxHeight="420"/>
            </Border>
          </StackPanel>

          <!-- NOTAS -->
          <StackPanel x:Name="PageNotas" Visibility="Collapsed">
            <TextBlock Text="Notas" Style="{StaticResource H1}"/>
            <TextBlock Text="Ficam neste PC. Nunca vão para a nuvem." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBox x:Name="NoteBox" Style="{StaticResource Field}" AcceptsReturn="True" Height="70"
                         VerticalContentAlignment="Top" TextWrapping="Wrap"/>
                <Button Content="Anotar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="AddNote_Click"/>
                <Border Style="{StaticResource Divider}"/>
                <ItemsControl x:Name="NotesList"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ATALHOS -->
          <StackPanel x:Name="PageAtalhos" Visibility="Collapsed">
            <TextBlock Text="Atalhos de texto" Style="{StaticResource H1}"/>
            <TextBlock Text="Frase que se expande no comando: “expande assinatura”." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Gatilho" Style="{StaticResource Label}"/>
                <TextBox x:Name="ShortcutTrigger" Style="{StaticResource Field}" Margin="0,6,0,0"/>
                <TextBlock Text="Texto" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                <TextBox x:Name="ShortcutText" Style="{StaticResource Field}" Margin="0,6,0,0"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                <Button Content="Adicionar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="AddShortcut_Click"/>
                <Border Style="{StaticResource Divider}"/>
                <ItemsControl x:Name="ShortcutsList"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- MEMÓRIA -->
          <StackPanel x:Name="PageMemoria" Visibility="Collapsed">
            <TextBlock Text="Memória do Orbi" Style="{StaticResource H1}"/>
            <TextBlock Text="O que você pediu, o que foi feito e o que você anotou. É daqui que saem as respostas para “o que eu fiz hoje?”." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="MemoriaResumo" Style="{StaticResource Muted}"/>
                <Border Style="{StaticResource Divider}"/>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="MemoriaList"/>
                </ScrollViewer>
                <Border Style="{StaticResource Divider}"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Esquecer tudo" Style="{StaticResource PrimaryButton}" Click="ForgetMemory_Click"/>
                  <TextBlock x:Name="MemoriaStatus" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- SEGURANÇA -->
          <StackPanel x:Name="PageSeguranca" Visibility="Collapsed">
            <TextBlock Text="Segurança" Style="{StaticResource H1}"/>
            <TextBlock Text="O que fica no PC, o que vai para a conta e o bloqueio automático." Style="{StaticResource Muted}" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Bloquear por inatividade" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <TextBlock Text="Avisa na tela e bloqueia o Windows com a sua senha." Style="{StaticResource Muted}"/>
                  </StackPanel>
                  <ToggleButton x:Name="LockToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Depois de" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                  <TextBox x:Name="LockMinutes" Width="56" Style="{StaticResource Field}" Margin="8,0"/>
                  <TextBlock Text="minutos sem teclado nem mouse." Style="{StaticResource Body}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="O que nunca sai deste PC" Style="{StaticResource Label}"/>
                <TextBlock Text="Notas · histórico da área de transferência · chave do Gemini · lembretes · logs"
                           Style="{StaticResource Body}" Margin="0,6,0,0"/>
                <Border Style="{StaticResource Divider}"/>
                <TextBlock Text="O que pode ir para a sua conta" Style="{StaticResource Label}"/>
                <TextBlock Text="Nome, e-mail, memória do Orbi, atalhos de texto, preferências e a lista de PCs"
                           Style="{StaticResource Body}" Margin="0,6,0,0"/>
                <Border Style="{StaticResource Divider}"/>
                <TextBlock Text="Chave do Gemini" Style="{StaticResource Label}"/>
                <TextBlock Text="Cifrada com DPAPI, vinculada ao seu usuário do Windows. Nem outro usuário do mesmo PC consegue ler."
                           Style="{StaticResource Body}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <Button Content="Salvar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Margin="0,16,0,0" Click="SaveSecurity_Click"/>
          </StackPanel>

          <!-- SOBRE -->
          <StackPanel x:Name="PageSobre" Visibility="Collapsed">
            <TextBlock Text="Sobre" Style="{StaticResource H1}"/>
            <TextBlock Text="Orbi 1.0.0 · Windows 11 x64" Style="{StaticResource Muted}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Um assistente em português, feito para o Windows." Style="{StaticResource Body}" FontWeight="SemiBold"/>
                <TextBlock Text="Comandos locais não usam internet. O Gemini entra só quando o assunto foge do script."
                           Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <Border Style="{StaticResource Divider}"/>
                <TextBlock Text="Verificar atualizações" Style="{StaticResource Label}"/>
                <Button Content="Abrir a página de releases" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenReleases_Click"/>
                <Border Style="{StaticResource Divider}"/>
                <TextBlock Text="Pasta de dados" Style="{StaticResource Label}"/>
                <TextBlock x:Name="DataPath" Style="{StaticResource MonoText}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- rodapé -->
    <Border Grid.Row="2" Background="#FFF7F2E8" BorderBrush="{StaticResource Rule}"
            BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock Text="Orbi · dados locais em %APPDATA%\Orbi · conta no Firebase" Style="{StaticResource Label}"/>
    </Border>
  </Grid>
</Window>
