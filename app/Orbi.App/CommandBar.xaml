<Window x:Class="Orbi.CommandBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbi"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="420" MinHeight="62"
        WindowStartupLocation="Manual"
        Background="{StaticResource Film}"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource Sans}">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- entrada (arrasta a janela) -->
    <Border x:Name="Header" Grid.Row="0" Background="{StaticResource Film2}"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid x:Name="HeaderGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="Mark" Grid.Column="0" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <Grid Grid.Column="1" x:Name="InputHost">
          <TextBox x:Name="Input"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Bone}" CaretBrush="{StaticResource SignalBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="16"
                   VerticalAlignment="Center"
                   TextChanged="Input_TextChanged"
                   KeyDown="Input_KeyDown"
                   PreviewKeyDown="Input_PreviewKeyDown"/>

          <TextBlock x:Name="Hint" Text="Digite ou peça"
                     Foreground="#66F1EBDF" FontFamily="{StaticResource Sans}" FontSize="16"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Três pontos: cai um painel com conta, ajustes e IA -->
          <Button x:Name="FullButton" Click="FullButton_Click"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Padding="8,4" ToolTip="Tela cheia">
            <Grid Width="16" Height="16">
              <Path x:Name="FullGlyph" Stroke="#99F1EBDF" StrokeThickness="1.4"
                    Data="M2,6 L2,3 Q2,2 3,2 L6,2 M10,2 L13,2 Q14,2 14,3 L14,6 M14,10 L14,13 Q14,14 13,14 L10,14 M6,14 L3,14 Q2,14 2,13 L2,10"
                    Stretch="None"/>
            </Grid>
          </Button>

          <Button x:Name="AccountButton" Click="AccountButton_Click"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Padding="9,4" ToolTip="Perfil">
            <Grid Width="16" Height="16">
              <TextBlock x:Name="ProfileGlyph" Text="p" Foreground="#E9E3D6"
                         FontFamily="{StaticResource CondFont}" FontSize="15" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse x:Name="AccountDot" Width="5" Height="5" Fill="#C7452A"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
            </Grid>
          </Button>

        </StackPanel>
      </Grid>
    </Border>

    <!-- braços laterais: só em janela larga e alta -->
    <Grid x:Name="Arms" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="228"/>
      </Grid.ColumnDefinitions>

      <!-- esquerda: onde você está agora -->
      <Border x:Name="RailLeft" Grid.Column="0" Background="{StaticResource Film}"
              BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
        <StackPanel x:Name="RailLeftBody" Margin="16,14,16,14"/>
      </Border>

      <!-- direita: o que está aberto -->
      <Border x:Name="RailRight" Grid.Column="2" Background="{StaticResource Film}"
              BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0">
        <StackPanel x:Name="RailRightBody" Margin="16,14,16,14"/>
      </Border>
    </Grid>

    <!-- resultados -->
    <ListBox x:Name="Results" Grid.Row="1" Margin="10,0"
             Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource ResultItem}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="Results_MouseDoubleClick"
             PreviewMouseLeftButtonUp="Results_Click">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="#FFE9846A"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Text}" Foreground="{StaticResource Bone}" FontSize="13.5" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}"
                         FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                         Visibility="{Binding DetailVisibility}"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="3"
                    VerticalAlignment="Top" Margin="10,1,0,0">
              <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeTextBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="9"/>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- rodapé -->
    <Border x:Name="FooterBar" Grid.Row="2" Background="{StaticResource Film2}">
      <Grid x:Name="FooterGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Footer" Grid.Column="0" Text="/ ferramentas · Esc esconde"
                   Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10"
                   TextTrimming="CharacterEllipsis"/>

        <TextBlock x:Name="AiStatus" Grid.Column="1" Text="local"
                   Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="10,0,0,0"/>
      </Grid>
    </Border>

    <!-- painel que cai da barra: conta, ajustes, IA ou ferramentas -->
    <Border x:Name="Sheet" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
            Background="{StaticResource Film2}" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SheetHeader" Grid.Row="0" Margin="14,10,10,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SheetTitle" Grid.Column="0" Text="" VerticalAlignment="Center"
                     Foreground="{StaticResource Bone}" FontFamily="{StaticResource Display}" FontSize="13"/>
          <TextBlock x:Name="SheetNote" Grid.Column="1" Text="" Margin="10,0,0,0" VerticalAlignment="Center"
                     Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10"
                     TextTrimming="CharacterEllipsis"/>
          <Button x:Name="SheetClose" Grid.Column="2" Content="voltar" Click="SheetClose_Click"
                  Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,2"
                  Foreground="#99F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,10">
          <StackPanel x:Name="SheetBody"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
