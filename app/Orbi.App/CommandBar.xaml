<Window x:Class="Orbi.CommandBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbi"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="{StaticResource Film}"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource Sans}">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- entrada (arrasta a janela) -->
    <Border x:Name="Header" Grid.Row="0" Background="{StaticResource Film2}"
            BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid x:Name="HeaderGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Mark" Grid.Column="0" Background="{StaticResource SignalBrush}" CornerRadius="3"
                VerticalAlignment="Center">
          <TextBlock Text="&#x25CF;" Foreground="White" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Column="1" x:Name="InputHost">
          <TextBox x:Name="Input"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Bone}" CaretBrush="{StaticResource SignalBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="16"
                   VerticalAlignment="Center"
                   TextChanged="Input_TextChanged"
                   KeyDown="Input_KeyDown"
                   PreviewKeyDown="Input_PreviewKeyDown"/>

          <TextBlock x:Name="Hint" Text="Digite um comando ou uma pergunta…"
                     Foreground="#66F1EBDF" FontFamily="{StaticResource Sans}" FontSize="16"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Conta: abre um menu com conta, ajustes e ferramentas -->
          <Button x:Name="AccountButton" Click="AccountButton_Click"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  ToolTip="Conta, ajustes e ferramentas">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Avatar" Width="22" Height="22" CornerRadius="11"
                      Background="{StaticResource SignalBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="AvatarInitial" Text="O" Foreground="White" FontSize="10.5"
                           FontFamily="{StaticResource Sans}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Button>

          <Border x:Name="EscBadge" Background="#22FFFFFF" CornerRadius="3"
                  Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="Esc" Foreground="#99F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- resultados -->
    <ListBox x:Name="Results" Grid.Row="1"
             Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource ResultItem}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="Results_MouseDoubleClick"
             PreviewMouseLeftButtonUp="Results_Click">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="#FFE9846A"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Text}" Foreground="{StaticResource Bone}" FontSize="13.5" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}"
                         FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                         Visibility="{Binding DetailVisibility}"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="3"
                    VerticalAlignment="Top" Margin="10,1,0,0">
              <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeTextBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="9"/>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- rodapé -->
    <Border x:Name="FooterBar" Grid.Row="2" Background="{StaticResource Film2}"
            BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0">
      <Grid x:Name="FooterGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Footer" Grid.Column="0" Text="Enter executa · Esc esconde"
                   Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10"
                   TextTrimming="CharacterEllipsis"/>

        <TextBlock x:Name="AiStatus" Grid.Column="1" Text="local"
                   Foreground="#80F1EBDF" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="10,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
