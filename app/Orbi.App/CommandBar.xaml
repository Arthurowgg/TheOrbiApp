<Window x:Class="Orbi.CommandBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbi"
        Width="700" Height="430"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        MinWidth="520" MinHeight="300"
        Background="{StaticResource Film}"
        BorderBrush="{StaticResource SignalBrush}"
        BorderThickness="0"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- entrada -->
    <Border Grid.Row="0" Background="{StaticResource Film2}" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1"
            Padding="16,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- marca -->
        <Border Grid.Column="0" Width="28" Height="28" Background="{StaticResource SignalBrush}"
                CornerRadius="3" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="&#x25CF;" Foreground="#FFFFFFFF" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Column="1">
          <TextBox x:Name="Input"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Bone}" CaretBrush="{StaticResource SignalBrush}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="16"
                   VerticalAlignment="Center"
                   TextChanged="Input_TextChanged"
                   KeyDown="Input_KeyDown"
                   PreviewKeyDown="Input_PreviewKeyDown"/>

          <TextBlock x:Name="Hint" Text="Digite um comando ou uma pergunta…"
                     Foreground="#66F1EBDF" FontFamily="Segoe UI" FontSize="16"
                     VerticalAlignment="Center" IsHitTestVisible="False" Margin="1,0,0,0"/>
        </Grid>

        <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="3" Padding="7,4"
                VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="Esc" Foreground="#99F1EBDF" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>
        </Border>
      </Grid>
    </Border>

    <!-- resultados -->
    <ListBox x:Name="Results" Grid.Row="1"
             Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource ResultItem}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="Results_MouseDoubleClick"
             PreviewMouseLeftButtonUp="Results_Click">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="#FFE9846A"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Text}" Foreground="{StaticResource Bone}" FontFamily="Segoe UI" FontSize="13.5"
                         TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" Foreground="#80F1EBDF" FontFamily="Cascadia Mono, Consolas"
                         FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                         Visibility="{Binding DetailVisibility}"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="3"
                    Padding="6,2" VerticalAlignment="Top" Margin="10,1,0,0">
              <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeTextBrush}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="9"/>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- rodapé -->
    <Border Grid.Row="2" Background="{StaticResource Film2}" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="16,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Footer" Grid.Column="0" Text="Enter executa · Esc esconde · 🖱 ajustes"
                   Foreground="#66F1EBDF" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>

        <TextBlock x:Name="AiStatus" Grid.Column="2" Text="local"
                   Foreground="#80F1EBDF" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>
      </Grid>
    </Border>
  </Grid>
</Window>
