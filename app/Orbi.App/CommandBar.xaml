<Window x:Class="Orbi.CommandBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbi"
        Width="680" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Border x:Name="Shell" Background="#F513100C" CornerRadius="6"
          BorderBrush="#33FFFFFF" BorderThickness="1" Padding="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- entrada -->
      <Border Grid.Row="0" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" Padding="14,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- marca -->
          <Border Grid.Column="0" Width="26" Height="26" Background="#FFC7452A"
                  CornerRadius="3" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="&#x25CF;" Foreground="White" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBox x:Name="Input" Grid.Column="1"
                   Background="Transparent" BorderThickness="0"
                   Foreground="#FFF1EBDF" CaretBrush="#FFC7452A"
                   FontFamily="Cascadia Mono, Consolas" FontSize="15"
                   VerticalAlignment="Center"
                   TextChanged="Input_TextChanged"
                   KeyDown="Input_KeyDown"
                   PreviewKeyDown="Input_PreviewKeyDown"/>

          <TextBlock x:Name="Hint" Grid.Column="1" Text="Digite um comando ou uma pergunta…"
                     Foreground="#66F1EBDF" FontFamily="Segoe UI" FontSize="15"
                     VerticalAlignment="Center" IsHitTestVisible="False" Margin="1,0,0,0"/>

          <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="3" Padding="7,4"
                  VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="Esc" Foreground="#99F1EBDF" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>
          </Border>
        </Grid>
      </Border>

      <!-- resultados -->
      <ListBox x:Name="Results" Grid.Row="1"
               Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource ResultItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="Results_MouseDoubleClick"
               PreviewMouseLeftButtonUp="Results_Click">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="#FFE9846A"
                         FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Text}" Foreground="#FFF1EBDF" FontFamily="Segoe UI" FontSize="13.5"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Detail}" Foreground="#80F1EBDF" FontFamily="Cascadia Mono, Consolas"
                           FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding DetailVisibility}"/>
              </StackPanel>

              <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="3"
                      Padding="6,2" VerticalAlignment="Top" Margin="10,1,0,0">
                <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeTextBrush}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="9"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- rodapé -->
      <Border Grid.Row="2" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="Footer" Grid.Column="0" Text="Alt+Space abre · Enter executa · Esc fecha"
                     Foreground="#66F1EBDF" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>

          <TextBlock x:Name="AiStatus" Grid.Column="2" Text="local"
                     Foreground="#80F1EBDF" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
