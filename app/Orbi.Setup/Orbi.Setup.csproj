<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbiSetup</AssemblyName>
    <RootNamespace>Orbi.Setup</RootNamespace>
    <ApplicationIcon>..\Orbi.App\Assets\orbi.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <FileVersion>1.1.2.0</FileVersion>
    <Company>Orbi</Company>
    <Product>Orbi</Product>
    <Description>Instalador do Orbi</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Win32 puro + NativeAOT: o instalador inteiro fica em poucos MB,
         roda antes de existir .NET no PC e não extrai nada na partida. -->
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="assets\**" />
    <EmbeddedResource Include="assets\orbi.png" Condition="Exists('assets\orbi.png')" />
  </ItemGroup>

</Project>
